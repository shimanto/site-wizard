# Gemini API key (for image generation via nano-banana-pro-preview)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare (optional — only needed if the wizard creates the Pages project)
# If unset, you must create the Pages project manually in the Cloudflare dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
